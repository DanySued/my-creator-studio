# Copy this to .env and fill in your values
# The app will guide you through getting each key in the Settings page

# Google Gemini — get from aistudio.google.com
GEMINI_API_KEY=

# Pexels — get from pexels.com/api
PEXELS_API_KEY=

# Internal (set automatically by docker-compose — do not change)
API_URL=http://api:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
